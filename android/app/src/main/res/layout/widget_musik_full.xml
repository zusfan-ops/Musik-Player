<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="#FFFFFFFF"
            android:contentDescription="Logo"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="M3U MUSIK • OFFLINE"
                android:textColor="#FF1DB954"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="M3U Musik &amp; Hallsem Cinema"
                android:textColor="#FFF8FAFC"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Ketuk Play untuk memulai musik"
                android:textColor="#FF94A3B8"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="#26FFFFFF"
        android:progressTint="#FF1DB954" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_prev"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_btn_subtle"
            android:contentDescription="Previous"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#FFFFFFFF" />

        <ImageButton
            android:id="@+id/btn_play_pause"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/widget_btn_green"
            android:contentDescription="Play/Pause"
            android:src="@android:drawable/ic_media_play"
            android:tint="#FF000000" />

        <ImageButton
            android:id="@+id/btn_next"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_btn_subtle"
            android:contentDescription="Next"
            android:src="@android:drawable/ic_media_next"
            android:tint="#FFFFFFFF" />
    </LinearLayout>
</LinearLayout>
