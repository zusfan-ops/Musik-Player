<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/widget_logo"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="#FFFFFFFF"
        android:contentDescription="Logo"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@mipmap/ic_launcher" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="M3U Musik Offline"
            android:textColor="#FFF8FAFC"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Ketuk untuk memutar musik"
            android:textColor="#FF94A3B8"
            android:textSize="11.5sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_prev"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/widget_btn_subtle"
        android:contentDescription="Previous"
        android:src="@android:drawable/ic_media_previous"
        android:tint="#FFFFFFFF" />

    <ImageButton
        android:id="@+id/btn_play_pause"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_btn_green"
        android:contentDescription="Play/Pause"
        android:src="@android:drawable/ic_media_play"
        android:tint="#FF000000" />

    <ImageButton
        android:id="@+id/btn_next"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_btn_subtle"
        android:contentDescription="Next"
        android:src="@android:drawable/ic_media_next"
        android:tint="#FFFFFFFF" />
</LinearLayout>
