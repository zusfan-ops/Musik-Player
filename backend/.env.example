APP_NAME="MediaCenter API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mediacenter.ordr.my.id

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mediacenter
DB_USERNAME=mediacenter
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@mediacenter.ordr.my.id"
MAIL_FROM_NAME="${APP_NAME}"

MEDIACENTER_API_BASE_URL=https://mediacenter.ordr.my.id/api/v1
MEDIACENTER_CORS_ORIGINS=https://mediacenter.ordr.my.id
MEDIACENTER_MAX_DEVICES=5
MEDIACENTER_MAX_PLAYLISTS=100
MEDIACENTER_MAX_PLAYLIST_ITEMS=500
MEDIACENTER_MAX_FAVORITES=1000
MEDIACENTER_ANALYTICS_RETENTION_DAYS=90
MEDIACENTER_ANALYTICS_MAX_BATCH=50
